# Conexão com o PostgreSQL
DATABASE_URL=postgres://postgres:nexo@localhost:5432/nexo
# Banco usado pelos testes automatizados (npm test)
DATABASE_URL_TESTE=postgres://postgres:nexo@localhost:5432/nexo_test
# Porta HTTP da API
PORTA=3333
# Endereço em que a API escuta (0.0.0.0 para aceitar outros computadores da loja)
HOST=0.0.0.0
# Segredo usado para assinar dados internos. Troque em produção (mínimo 32 caracteres).
SEGREDO_SESSAO=troque-este-segredo-por-um-valor-longo-e-aleatorio
# Origem do front (CORS e verificação de origem contra CSRF). Separe várias por vírgula.
ORIGEM_WEB=http://localhost:5173
# true quando a API for servida por HTTPS (marca o cookie como Secure)
COOKIE_SEGURO=false
# Nível de log: fatal, error, warn, info, debug
NIVEL_LOG=info
